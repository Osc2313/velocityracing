{
  "name": "twilight-leaderboard",
  "version": "1.0.0",
  "description": "Sim racing leaderboard app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --target node18-win-x64 --output dist/TwilightLeaderboard-Windows.exe --compress GZip",
    "build:mac": "pkg . --target node18-macos-x64 --output dist/TwilightLeaderboard-Mac --compress GZip",
    "build:all": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output dist/TwilightLeaderboard --compress GZip"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": []
  },
  "dependencies": {
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
