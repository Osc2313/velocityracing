{
  "name": "velocity-racing",
  "version": "1.0.0",
  "description": "Velocity Racing leaderboard app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --target node18-win-x64 --output dist/VelocityRacing-Windows.exe --compress GZip",
    "build:mac": "pkg . --target node18-macos-x64 --output dist/VelocityRacing-Mac --compress GZip",
    "build:all": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --output dist/VelocityRacing --compress GZip"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "tessdata/**/*"
    ],
    "scripts": []
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
